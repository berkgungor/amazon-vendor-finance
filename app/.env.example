# Local development. Copy to .env.local (git-ignored) and fill in.
# Deployed as a Snowflake App none of this is needed: users sign in with Snowflake and every
# query runs as them (caller's rights).

SNOWFLAKE_ACCOUNT=sfsehol-anthropic_snowflake_hackathon_dvsxzc
SNOWFLAKE_ACCOUNT_URL=https://sfsehol-anthropic-snowflake-hackathon-dvsxzc.snowflakecomputing.com
SNOWFLAKE_USER=
# Programmatic access token restricted to AMZ_FIN_USER, e.g.
#   ALTER USER <you> ADD PROGRAMMATIC ACCESS TOKEN AMZ_FIN_LOCAL ROLE_RESTRICTION = 'AMZ_FIN_USER' DAYS_TO_EXPIRY = 7;
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=AMZ_FIN_USER
SNOWFLAKE_WAREHOUSE=AMZ_FIN_WH
